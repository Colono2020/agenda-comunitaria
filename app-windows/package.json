{
  "name": "agenda-comunitaria",
  "productName": "Agenda Comunitária",
  "version": "1.0.0",
  "description": "Agenda Comunitária para Windows",
  "author": "Agenda Comunitária",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "br.agendacomunitaria.app",
    "productName": "Agenda Comunitária",
    "executableName": "AgendaComunitaria",
    "directories": {
      "output": "instalador"
    },
    "files": [
      "main.js",
      "offline.html",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agenda Comunitária",
      "artifactName": "Agenda-Comunitaria-Instalador-${version}.${ext}",
      "language": "1046"
    }
  }
}
